rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    function isMember(orgId) {
      return signedIn() && exists(memberPath(orgId)) && get(memberPath(orgId)).data.status == 'active';
    }

    function hasRole(orgId, roles) {
      return isMember(orgId) && get(memberPath(orgId)).data.role in roles;
    }

    function validRole(role) {
      return role in ['admin', 'procurement_manager', 'procurement_staff', 'viewer'];
    }

    function validSupplier(orgId, data) {
      return data.organizationId == orgId
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.normalizedName is string && data.normalizedName.size() >= 2 && data.normalizedName.size() <= 120
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.contactName is string && data.contactName.size() <= 80
        && data.email is string && data.email.size() <= 160
        && data.phone is string && data.phone.size() <= 30
        && data.address is string && data.address.size() <= 240
        && data.notes is string && data.notes.size() <= 600
        && data.status in ['active', 'inactive']
        && data.createdBy is string && data.updatedBy is string
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.keys().hasOnly([
          'organizationId', 'name', 'normalizedName', 'category', 'contactName',
          'email', 'phone', 'address', 'notes', 'status', 'createdBy', 'updatedBy',
          'createdAt', 'updatedAt'
        ]);
    }

    function validPurchaseRequest(orgId, data) {
      return data.organizationId == orgId
        && data.requestNumber is string && data.requestNumber.matches('^PR-[0-9]{4}-[A-Z0-9]{6}$')
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 140
        && data.normalizedTitle is string && data.normalizedTitle.size() >= 3 && data.normalizedTitle.size() <= 140
        && data.requesterName is string && data.requesterName.size() >= 2 && data.requesterName.size() <= 100
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 100
        && data.purpose is string && data.purpose.size() >= 10 && data.purpose.size() <= 800
        && data.budget is number && data.budget >= 0 && data.budget <= 1000000000
        && data.requiredDate is string && data.requiredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 30
        && data.notes is string && data.notes.size() <= 1200
        && data.status in ['draft', 'open', 'closed']
        && data.archived is bool
        && ((data.archived == true && data.archivedAt is timestamp)
          || (data.archived == false && data.archivedAt == null))
        && data.createdBy is string && data.updatedBy is string
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.keys().hasOnly([
          'organizationId', 'requestNumber', 'title', 'normalizedTitle',
          'requesterName', 'department', 'purpose', 'budget', 'requiredDate',
          'items', 'notes', 'status', 'archived', 'archivedAt', 'createdBy',
          'updatedBy', 'createdAt', 'updatedAt'
        ]);
    }

    function validRfq(orgId, data) {
      return data.organizationId == orgId
        && data.rfqNumber is string && data.rfqNumber.matches('^RFQ-[0-9]{4}-[A-Z0-9]{6}$')
        && data.purchaseRequestId is string && data.purchaseRequestId.size() >= 10 && data.purchaseRequestId.size() <= 80
        && data.purchaseRequestNumber is string && data.purchaseRequestNumber.matches('^PR-[0-9]{4}-[A-Z0-9]{6}$')
        && data.purchaseRequestTitle is string && data.purchaseRequestTitle.size() >= 3 && data.purchaseRequestTitle.size() <= 140
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 160
        && data.normalizedTitle is string && data.normalizedTitle.size() >= 3 && data.normalizedTitle.size() <= 160
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 30
        && data.criteria is list && data.criteria.size() >= 1 && data.criteria.size() <= 20
        && data.quotationDeadline is string && data.quotationDeadline.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.deliveryDestination is string && data.deliveryDestination.size() >= 5 && data.deliveryDestination.size() <= 240
        && data.paymentExpectations is string && data.paymentExpectations.size() >= 5 && data.paymentExpectations.size() <= 500
        && data.evaluationCriteria is string && data.evaluationCriteria.size() >= 10 && data.evaluationCriteria.size() <= 900
        && data.selectedSuppliers is list && data.selectedSuppliers.size() >= 1 && data.selectedSuppliers.size() <= 20
        && data.status in ['draft', 'issued', 'closed']
        && ((data.status == 'draft' && data.issuedAt == null && data.closedAt == null)
          || (data.status == 'issued' && data.issuedAt is timestamp && data.closedAt == null)
          || (data.status == 'closed' && data.issuedAt is timestamp && data.closedAt is timestamp))
        && data.createdBy is string && data.updatedBy is string
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.keys().hasOnly([
          'organizationId', 'rfqNumber', 'purchaseRequestId', 'purchaseRequestNumber',
          'purchaseRequestTitle', 'title', 'normalizedTitle', 'items', 'criteria',
          'quotationDeadline', 'deliveryDestination', 'paymentExpectations',
          'evaluationCriteria', 'selectedSuppliers', 'status', 'issuedAt', 'closedAt',
          'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
        ]);
    }

    function validQuotation(orgId, data) {
      return data.organizationId == orgId
        && data.quotationNumber is string && data.quotationNumber.matches('^QT-[0-9]{4}-[A-Z0-9]{6}$')
        && data.rfqId is string && data.rfqId.size() >= 10 && data.rfqId.size() <= 80
        && data.rfqNumber is string && data.rfqNumber.matches('^RFQ-[0-9]{4}-[A-Z0-9]{6}$')
        && data.rfqTitle is string && data.rfqTitle.size() >= 3 && data.rfqTitle.size() <= 160
        && data.supplierId is string && data.supplierId.size() >= 10 && data.supplierId.size() <= 80
        && data.supplierName is string && data.supplierName.size() >= 2 && data.supplierName.size() <= 120
        && data.normalizedSupplierName is string && data.normalizedSupplierName.size() >= 2 && data.normalizedSupplierName.size() <= 120
        && data.currency == 'PHP'
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 30
        && data.discount is number && data.discount >= 0 && data.discount <= 1000000000
        && data.shipping is number && data.shipping >= 0 && data.shipping <= 1000000000
        && data.installation is number && data.installation >= 0 && data.installation <= 1000000000
        && data.tax is number && data.tax >= 0 && data.tax <= 1000000000
        && data.warranty is string && data.warranty.size() >= 2 && data.warranty.size() <= 500
        && data.deliveryCommitment is string && data.deliveryCommitment.size() >= 2 && data.deliveryCommitment.size() <= 500
        && data.paymentTerms is string && data.paymentTerms.size() >= 2 && data.paymentTerms.size() <= 500
        && data.notes is string && data.notes.size() <= 1000
        && data.source is map
        && data.source.type in ['manual', 'csv', 'pdf', 'excel']
        && data.source.filename is string && data.source.filename.size() <= 180
        && data.source.checksum is string && data.source.checksum.size() <= 64
        && data.source.keys().hasOnly(['type', 'filename', 'checksum'])
        && data.status in ['draft', 'needs_review', 'verified']
        && ((data.status == 'draft' && data.submittedAt == null && data.verifiedAt == null && data.verifiedBy == '')
          || (data.status == 'needs_review' && data.submittedAt is timestamp && data.verifiedAt == null && data.verifiedBy == '')
          || (data.status == 'verified' && data.submittedAt is timestamp && data.verifiedAt is timestamp && data.verifiedBy is string && data.verifiedBy.size() > 0))
        && data.createdBy is string && data.updatedBy is string
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.keys().hasOnly([
          'organizationId', 'quotationNumber', 'rfqId', 'rfqNumber', 'rfqTitle',
          'supplierId', 'supplierName', 'normalizedSupplierName', 'currency', 'items',
          'discount', 'shipping', 'installation', 'tax', 'warranty',
          'deliveryCommitment', 'paymentTerms', 'notes', 'source', 'status',
          'submittedAt', 'verifiedAt', 'verifiedBy', 'createdBy', 'updatedBy',
          'createdAt', 'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'activeOrganizationId', 'createdAt', 'updatedAt']);
      allow update: if isSelf(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'activeOrganizationId', 'updatedAt']);
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow read: if isMember(orgId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.keys().hasOnly(['name', 'normalizedName', 'createdBy', 'createdAt', 'updatedAt']);
      allow update: if hasRole(orgId, ['admin'])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'normalizedName', 'updatedAt']);
      allow delete: if hasRole(orgId, ['admin']);

      match /members/{memberId} {
        allow read: if isMember(orgId);
        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.organizationId == orgId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'admin'
          && request.resource.data.status == 'active'
          && request.resource.data.keys().hasOnly(['organizationId', 'userId', 'email', 'displayName', 'role', 'status', 'joinedAt', 'updatedAt'])
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy == request.auth.uid;
        allow update: if hasRole(orgId, ['admin'])
          && memberId != request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.email == resource.data.email
          && validRole(request.resource.data.role)
          && request.resource.data.status in ['active', 'suspended']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'updatedAt']);
        allow delete: if hasRole(orgId, ['admin']) && memberId != request.auth.uid;
      }

      match /suppliers/{supplierId} {
        allow read: if isMember(orgId);
        allow create: if hasRole(orgId, ['admin', 'procurement_manager', 'procurement_staff'])
          && validSupplier(orgId, request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if hasRole(orgId, ['admin', 'procurement_manager', 'procurement_staff'])
          && validSupplier(orgId, request.resource.data)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /purchaseRequests/{requestId} {
        allow read: if isMember(orgId);
        allow create: if hasRole(orgId, ['admin', 'procurement_manager', 'procurement_staff'])
          && validPurchaseRequest(orgId, request.resource.data)
          && request.resource.data.status in ['draft', 'open']
          && request.resource.data.archived == false
          && request.resource.data.archivedAt == null
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if hasRole(orgId, ['admin', 'procurement_manager', 'procurement_staff'])
          && validPurchaseRequest(orgId, request.resource.data)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.requestNumber == resource.data.requestNumber
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && (!resource.data.archived || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'archivedAt', 'updatedBy', 'updatedAt']))
          && (hasRole(orgId, ['admin', 'procurement_manager'])
            || (resource.data.status != 'closed' && request.resource.data.status != 'closed'));
        allow delete: if false;
      }

      match /rfqs/{rfqId} {
        allow read: if isMember(orgId);
        allow create: if hasRole(orgId, ['admin', 'procurement_manager', 'procurement_staff'])
          && validRfq(orgId, request.resource.data)
          && request.resource.data.status == 'draft'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && exists(/databases/$(database)/documents/organizations/$(orgId)/purchaseRequests/$(request.resource.data.purchaseRequestId))
          && get(/databases/$(database)/documents/organizations/$(orgId)/purchaseRequests/$(request.resource.data.purchaseRequestId)).data.status == 'open'
          && get(/databases/$(database)/documents/organizations/$(orgId)/purchaseRequests/$(request.resource.data.purchaseRequestId)).data.archived == false;
        allow update: if validRfq(orgId, request.resource.data)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.rfqNumber == resource.data.rfqNumber
          && request.resource.data.purchaseRequestId == resource.data.purchaseRequestId
          && request.resource.data.purchaseRequestNumber == resource.data.purchaseRequestNumber
          && request.resource.data.purchaseRequestTitle == resource.data.purchaseRequestTitle
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && (
            (resource.data.status == 'draft'
              && request.resource.data.status == 'draft'
              && hasRole(orgId, ['admin', 'procurement_manager', 'procurement_staff'])
              && get(/databases/$(database)/documents/organizations/$(orgId)/purchaseRequests/$(resource.data.purchaseRequestId)).data.status == 'open'
              && get(/databases/$(database)/documents/organizations/$(orgId)/purchaseRequests/$(resource.data.purchaseRequestId)).data.archived == false)
            || (resource.data.status == 'draft'
              && request.resource.data.status == 'issued'
              && hasRole(orgId, ['admin', 'procurement_manager'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'issuedAt', 'closedAt', 'updatedBy', 'updatedAt'])
              && get(/databases/$(database)/documents/organizations/$(orgId)/purchaseRequests/$(resource.data.purchaseRequestId)).data.status == 'open'
              && get(/databases/$(database)/documents/organizations/$(orgId)/purchaseRequests/$(resource.data.purchaseRequestId)).data.archived == false)
            || (resource.data.status == 'issued'
              && request.resource.data.status == 'closed'
              && hasRole(orgId, ['admin', 'procurement_manager'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt', 'updatedBy', 'updatedAt']))
          );
        allow delete: if false;
      }

      match /quotations/{quotationId} {
        allow read: if isMember(orgId);
        allow create: if hasRole(orgId, ['admin', 'procurement_manager', 'procurement_staff'])
          && validQuotation(orgId, request.resource.data)
          && request.resource.data.status == 'draft'
          && quotationId == request.resource.data.rfqId + '_' + request.resource.data.supplierId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && exists(/databases/$(database)/documents/organizations/$(orgId)/rfqs/$(request.resource.data.rfqId))
          && get(/databases/$(database)/documents/organizations/$(orgId)/rfqs/$(request.resource.data.rfqId)).data.status == 'issued'
          && get(/databases/$(database)/documents/organizations/$(orgId)/rfqs/$(request.resource.data.rfqId)).data.rfqNumber == request.resource.data.rfqNumber
          && get(/databases/$(database)/documents/organizations/$(orgId)/rfqs/$(request.resource.data.rfqId)).data.title == request.resource.data.rfqTitle
          && {'id': request.resource.data.supplierId, 'name': request.resource.data.supplierName} in get(/databases/$(database)/documents/organizations/$(orgId)/rfqs/$(request.resource.data.rfqId)).data.selectedSuppliers
          && exists(/databases/$(database)/documents/organizations/$(orgId)/suppliers/$(request.resource.data.supplierId))
          && get(/databases/$(database)/documents/organizations/$(orgId)/suppliers/$(request.resource.data.supplierId)).data.name == request.resource.data.supplierName;
        allow update: if validQuotation(orgId, request.resource.data)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.quotationNumber == resource.data.quotationNumber
          && request.resource.data.rfqId == resource.data.rfqId
          && request.resource.data.rfqNumber == resource.data.rfqNumber
          && request.resource.data.rfqTitle == resource.data.rfqTitle
          && request.resource.data.supplierId == resource.data.supplierId
          && request.resource.data.supplierName == resource.data.supplierName
          && request.resource.data.normalizedSupplierName == resource.data.normalizedSupplierName
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && (
            (resource.data.status == 'draft'
              && request.resource.data.status == 'draft'
              && hasRole(orgId, ['admin', 'procurement_manager', 'procurement_staff']))
            || (resource.data.status == 'draft'
              && request.resource.data.status == 'needs_review'
              && hasRole(orgId, ['admin', 'procurement_manager', 'procurement_staff'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'submittedAt', 'verifiedAt', 'verifiedBy', 'updatedBy', 'updatedAt']))
            || (resource.data.status == 'needs_review'
              && request.resource.data.status == 'needs_review'
              && hasRole(orgId, ['admin', 'procurement_manager', 'procurement_staff']))
            || (resource.data.status == 'needs_review'
              && request.resource.data.status == 'verified'
              && hasRole(orgId, ['admin', 'procurement_manager'])
              && request.resource.data.verifiedBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verifiedAt', 'verifiedBy', 'updatedBy', 'updatedAt']))
          );
        allow delete: if false;
      }
    }
  }
}
