rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    function isMember(orgId) {
      return signedIn() && exists(memberPath(orgId)) && get(memberPath(orgId)).data.status == 'active';
    }

    function hasRole(orgId, roles) {
      return isMember(orgId) && get(memberPath(orgId)).data.role in roles;
    }

    function validRole(role) {
      return role in ['admin', 'procurement_manager', 'procurement_staff', 'viewer'];
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'activeOrganizationId', 'createdAt', 'updatedAt']);
      allow update: if isSelf(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'activeOrganizationId', 'updatedAt']);
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow read: if isMember(orgId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.keys().hasOnly(['name', 'normalizedName', 'createdBy', 'createdAt', 'updatedAt']);
      allow update: if hasRole(orgId, ['admin'])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'normalizedName', 'updatedAt']);
      allow delete: if hasRole(orgId, ['admin']);

      match /members/{memberId} {
        allow read: if isMember(orgId);
        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.organizationId == orgId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'admin'
          && request.resource.data.status == 'active'
          && request.resource.data.keys().hasOnly(['organizationId', 'userId', 'email', 'displayName', 'role', 'status', 'joinedAt', 'updatedAt'])
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy == request.auth.uid;
        allow update: if hasRole(orgId, ['admin'])
          && memberId != request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.email == resource.data.email
          && validRole(request.resource.data.role)
          && request.resource.data.status in ['active', 'suspended']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'updatedAt']);
        allow delete: if hasRole(orgId, ['admin']) && memberId != request.auth.uid;
      }
    }
  }
}
